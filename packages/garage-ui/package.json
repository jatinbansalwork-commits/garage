    "input",
    "ui",
    "components",
    "tailwind",
    "framer-motion",
    "accessible",
    "haptics",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinbansalwork-commits/garage.git",
